---
import Layout from '../layouts/Layout.astro';
import Quiz from '../components/Quiz.astro';
import ItsCard from '../components/ItsCard.astro';
import FlipCard from '../components/FlipCard.astro';

const datos = [
	{ cifra: '376M', texto: 'infecciones nuevas de ITS al año en el mundo' },
	{ cifra: '1,2M', texto: 'casos nuevos de VIH al año' },
	{ cifra: '50–97%', texto: 'de las ITS no muestran síntomas' },
	{ cifra: '90%', texto: 'de los casos de VPH se resuelven solos' },
];

const its = [
	{
		titulo: 'Qué son',
		texto:
			'Son infecciones que se transmiten principalmente por contacto sexual —por vía vaginal, anal u oral— y, en algunos casos, por contacto sanguíneo o de madre a hijo. La mayoría se trata y muchas se previenen.',
	},
	{
		titulo: 'Síntomas',
		texto:
			'Pueden no dar ningún síntoma: se estima que entre el 50% y el 97% de las ITS son asintomáticas. Cuando aparecen, pueden ser ardor al orinar, flujo inusual, úlceras o lesiones en genitales/boca, dolor o sarpullido. Ante cualquier señal, hacete el test.',
	},
	{
		titulo: 'Prevención',
		texto:
			'El uso correcto y constante del preservativo es la medida más eficaz. Sumar tests periódicos, la vacunación contra VPH y hepatitis B, y la educación sexual integral reducen aún más el riesgo.',
	},
	{
		titulo: 'Curables y controlables',
		texto:
			'Sífilis, gonorrea, clamidia y tricomonas son curables con tratamiento. VIH, hepatitis B, herpes y VPH no se curan, pero se controlan con medicación: con VIH, una carga viral indetectable no transmite.',
	},
];

const itsDetalle = [
	{
		nombre: 'Sífilis',
		estado: 'Curable',
		sintomas:
			'Úlcera indolora que aparece y desaparece; luego sarpullido, fiebre y ganglios. Puede pasar desapercibida.',
		transmision: 'Sexo vaginal, anal u oral; también de madre a hijo.',
		nota: 'Se cura con antibióticos (penicilina).',
	},
	{
		nombre: 'Gonorrea',
		estado: 'Curable',
		sintomas: 'Ardor al orinar y flujo purulento; muchas veces no da síntomas.',
		transmision: 'Sexo vaginal, anal u oral; de madre a hijo en el parto.',
		nota: 'Se cura con antibióticos: hay que completar el tratamiento.',
	},
	{
		nombre: 'Clamidia',
		estado: 'Curable',
		sintomas: 'Flujo, ardor al orinar o dolor abdominal; suele ser asintomática.',
		transmision: 'Sexo vaginal, anal u oral.',
		nota: 'Si no se trata, puede afectar la fertilidad.',
	},
	{
		nombre: 'Tricomoniasis',
		estado: 'Curable',
		sintomas: 'Flujo amarillento o verdoso con olor, picazón y ardor al orinar.',
		transmision: 'Principalmente contacto genital (vaginal); rara vez por sexo oral.',
		nota: 'Se cura con antibióticos; conviene tratar también a la pareja.',
	},
	{
		nombre: 'VIH',
		estado: 'Controlable',
		sintomas: 'Fase inicial tipo gripe; después puede pasar años sin síntomas.',
		transmision: 'Sangre, semen y fluidos sexuales, leche materna y agujas compartidas.',
		nota: 'Con tratamiento y carga viral indetectable, no se transmite.',
	},
	{
		nombre: 'Hepatitis B',
		estado: 'Controlable',
		sintomas: 'Cansancio, náuseas, dolor abdominal e ictericia; puede ser asintomática.',
		transmision: 'Sangre, fluidos sexuales y de madre a hijo.',
		nota: 'Hay vacuna y tratamiento para la forma crónica.',
	},
	{
		nombre: 'Herpes (VHS)',
		estado: 'Controlable',
		sintomas: 'Ampollas o úlceras dolorosas en genitales o boca; van y vienen.',
		transmision: 'Contacto piel a piel y sexo oral; puede transmitirse sin lesiones visibles.',
		nota: 'Los brotes se controlan con medicación.',
	},
	{
		nombre: 'VPH',
		estado: 'Se resuelve solo',
		sintomas: 'Muchas veces sin síntomas; puede causar verrugas genitales.',
		transmision: 'Contacto sexual piel a piel (vaginal, anal u oral).',
		nota: 'El 90% se resuelve solo; hay vacuna y controles (PAP/VPH).',
	},
];

const mitos = [
	{
		mito: 'Si no tengo síntomas, no tengo una ITS.',
		realidad:
			'Entre el 50% y el 97% de las ITS son asintomáticas. La única forma de saberlo es con un test: no esperes señales.',
	},
	{
		mito: 'Solo se contagian las personas con muchas parejas sexuales.',
		realidad:
			'Cualquier persona que tenga relaciones sexuales sin protección puede contagiarse. Basta una sola relación sin preservativo.',
	},
	{
		mito: 'El sexo oral no transmite ITS.',
		realidad:
			'Sí las transmite: herpes, gonorrea, clamidia, sífilis y VPH pueden pasar por sexo oral. Usá preservativo también ahí.',
	},
	{
		mito: 'El VIH se contagia por saliva, abrazos o compartir un vaso.',
		realidad:
			'No. Se transmite por sangre, semen y fluidos sexuales, leche materna y agujas compartidas. Con tratamiento indetectable no transmite.',
	},
	{
		mito: 'El VPH siempre termina en cáncer.',
		realidad:
			'No: el 90% de las infecciones por VPH se resuelven solas. La vacuna y los controles periódicos reducen el riesgo de complicaciones.',
	},
	{
		mito: 'La pastilla del día después protege de las ITS.',
		realidad:
			'No. Solo previene un embarazo; no protege de ninguna ITS. Para eso hace falta preservativo y tests periódicos.',
	},
];

const transmision = [
	{
		titulo: 'Genitales',
		texto:
			'Contacto sexual vaginal o anal: es la vía principal de la mayoría de las ITS.',
	},
	{
		titulo: 'Sexo oral',
		texto:
			'Puede transmitir herpes, gonorrea, clamidia, sífilis y VPH. El preservativo también se usa en el sexo oral.',
	},
	{
		titulo: 'Saliva / boca',
		texto:
			'Algunas infecciones, como el herpes oral y el VPH, pueden pasar por contacto de boca o saliva. La mayoría de las ITS no se contagian con un simple beso.',
	},
];

const leyes = [
	{
		nombre: 'Ley 25.673 — Salud Sexual y Procreación Responsable',
		texto:
			'Sancionada en 2002, es la ley marco en la materia. Creó el Programa Nacional que obliga a hospitales públicos, obras sociales y prepagas a entregar gratuitamente métodos anticonceptivos (preservativos, pastillas, DIU, anticoncepción de emergencia, etc.). Busca prevenir embarazos no intencionales y enfermedades de transmisión sexual.',
		link: 'https://www.argentina.gob.ar/justicia/derechofacil/leysimple/salud-sexual',
		linkTexto: 'Ver en argentina.gob.ar',
	},
	{
		nombre: 'Ley 26.150 — Educación Sexual Integral (ESI)',
		texto:
			'Sancionada en 2006, garantiza el derecho de todos los estudiantes —desde el nivel inicial hasta el secundario, en escuelas públicas y privadas— a recibir educación sexual integral, abordando prevención, cuidado del cuerpo, derechos y afectividad de manera científica y adaptada a cada edad.',
		link: 'http://www.legisalud.gov.ar/atlas/categorias/salud_reproductiva.html',
		linkTexto: 'Ver recurso',
	},
	{
		nombre: 'Ley 26.130 — Contracepción Quirúrgica',
		texto:
			'Garantiza que toda persona mayor de edad pueda acceder de forma gratuita a la ligadura de trompas o a la vasectomía en el sistema de salud. Solo se requiere consentimiento informado: no hace falta autorización judicial ni el aval de una pareja.',
		link: 'https://www.argentina.gob.ar/justicia/derechofacil/leysimple/anticoncepcion-quirurgica',
		linkTexto: 'Ver en argentina.gob.ar',
	},
];

const quizIts = [
	{
		pregunta: '¿Cuántas infecciones nuevas de ITS se estiman cada año en el mundo?',
		opciones: ['37,6 millones', '1,2 millones', '376 millones', '90 millones'],
		respuesta: 2,
		explicacion:
			'Son 376 millones de infecciones nuevas al año, mucho más de lo que se suele imaginar.',
	},
	{
		pregunta: 'Según los datos, ¿qué porcentaje de las ITS puede no dar síntomas?',
		opciones: ['Ninguna, todas dan síntomas', 'Entre 50% y 97%', 'Un 10%', 'Solo en hombres'],
		respuesta: 1,
		explicacion:
			'Entre el 50% y el 97% de las ITS son asintomáticas: no esperes señales para hacerte el test.',
	},
	{
		pregunta: '¿Cuál de estas ITS es curable?',
		opciones: ['VIH', 'Herpes', 'Sífilis', 'VPH'],
		respuesta: 2,
		explicacion:
			'La sífilis se cura con antibióticos. VIH, herpes y VPH no se curan, pero se controlan.',
	},
	{
		pregunta: '¿Qué porcentaje de infecciones por VPH se resuelven solas?',
		opciones: ['Un 50%', 'Un 75%', 'Un 90%', 'Ninguna'],
		respuesta: 2,
		explicacion:
			'El 90% de los casos de VPH se resuelven solos; aun así, el seguimiento médico es importante.',
	},
	{
		pregunta: '¿Cuál es la forma más eficaz de prevenir el contagio de ITS?',
		opciones: [
			'Usar preservativo de forma correcta y constante',
			'Usar doble preservativo a la vez',
			'Tomar vitamina C después del sexo',
			'Verificar que la persona no tenga síntomas a simple vista',
		],
		respuesta: 0,
		explicacion:
			'El preservativo usado bien, desde el inicio y en todo el acto, es la medida más eficaz. El doble preservativo genera fricción y se rompe.',
	},
];

const quizQueHarías = [
	{
		pregunta:
			'Conocés a alguien hace poco y propone no usar preservativo porque "no hay riesgo". ¿Qué hacés?',
		opciones: [
			'Aceptás, si ambos se ven sanos',
			'Le proponen hacerse los dos las pruebas de ITS y, hasta tener resultados, usar preservativo',
			'Lo dejan porque no confían el uno en el otro',
			'Usan preservativo solo si hay síntomas',
		],
		respuesta: 1,
		explicacion:
			'Ante la duda, tests para ambos y preservativo hasta tener resultados: la confianza no descarta infecciones asintomáticas.',
	},
	{
		pregunta:
			'Tu pareja fue diagnosticada con una ITS curable y está en tratamiento. ¿Cómo acompañás?',
		opciones: [
			'Le piden que no diga nada a nadie',
			'Le sugieren no tener relaciones hasta terminar el tratamiento y controlarse los dos',
			'Vos tomás antibióticos "por las dudas"',
			'Como es curable, siguen como si nada',
		],
		respuesta: 1,
		explicacion:
			'Completar el tratamiento, abstenerse hasta el alta y que ambas personas se controlen evita la ping-pong de contagios.',
	},
	{
		pregunta:
			'Tuviste una relación sin preservativo y no tenés ningún síntoma. ¿Qué hacés?',
		opciones: [
			'Nada: sin síntomas no hay problema',
			'Esperás a ver si aparece algo raro',
			'Te hacés el test y, mientras esperan los resultados, usás preservativo',
			'Te lavás con productos especiales',
		],
		respuesta: 2,
		explicacion:
			'Lavarse no previene ITS y la ausencia de síntomas no descarta nada: el test es la respuesta.',
	},
	{
		pregunta:
			'Un amigo te cuenta que tiene VIH y tiene miedo de que lo traten distinto. ¿Qué hacés?',
		opciones: [
			'Le decís que no lo toque nada porque "se contagia de todo"',
			'Lo acompañás, aprendés que con tratamiento no se transmite y se lo aclarás',
			'Lo alejás del grupo "por las dudas"',
			'Le pedís que no salga con nadie nunca más',
		],
		respuesta: 1,
		explicacion:
			'El VIH no se transmite con un abrazo, ni por saliva ni por compartir objetos. Con tratamiento y carga viral indetectable no se transmite.',
	},
];

const quizLeyes = [
	{
		pregunta: '¿Qué ley creó el Programa Nacional de Salud Sexual y Procreación Responsable?',
		opciones: ['Ley 26.150', 'Ley 25.673', 'Ley 27.610', 'Ley 27.675'],
		respuesta: 1,
		explicacion:
			'La Ley 25.673 (2002) es la ley marco: garantiza métodos anticonceptivos gratuitos en el sistema público, obras sociales y prepagas.',
	},
	{
		pregunta:
			'¿Cuáles son los requisitos principales para acceder a la interrupción voluntaria del embarazo (IVE)?',
		opciones: [
			'Ser mayor de 18 años y tener autorización judicial',
			'Ser mayor de 16 años y que el embarazo no supere las 14 semanas',
			'Ser casada y con autorización de la pareja',
			'No hay requisitos: es un derecho sin condiciones',
		],
		respuesta: 1,
		explicacion:
			'La Ley 27.610 garantiza el acceso hasta la semana 14 inclusive de gestación para mayores de 16 años, sin necesidad de autorización judicial.',
	},
	{
		pregunta:
			'¿Qué establece la Ley 27.610 sobre la información a terceros?',
		opciones: [
			'Se debe avisar a la familia siempre',
			'Los profesionales están obligados a informar a la pareja',
			'El acceso es confidencial: no se informa a terceros sin autorización',
			'Se registra en un padrón público',
		],
		respuesta: 2,
		explicacion:
			'La confidencialidad es un derecho: los equipos de salud no pueden informar a terceros sin tu autorización expresa.',
	},
	{
		pregunta: '¿Qué garantiza la Ley 26.130?',
		opciones: [
			'Preservativos gratuitos en hospitales',
			'Acceso gratuito a la contracepción quirúrgica (ligadura de trompas y vasectomía) por consentimiento informado',
			'Educación sexual en las escuelas',
			'Atención gratuita de las ITS',
		],
		respuesta: 1,
		explicacion:
